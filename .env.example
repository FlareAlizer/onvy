# Скопируй в .env и заполни. Реальный .env НЕ коммитим (он в .gitignore).

# --- Telegram-бот (скилл telegram-bot-aiogram) ---
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=

# --- FastAPI MVP (скилл fastapi-mvp) ---
SECRET_KEY=your_secret_key_here
# Ключ простой аутентификации MVP (заголовок X-API-Key / ?api_key= для WebSocket)
API_KEY=your_api_key_here
DATABASE_URL=sqlite+aiosqlite:///./app.db
DEBUG=false
# Язык по умолчанию для сотрудников и подсказок ассистента
DEFAULT_LANGUAGE=ru

# --- Yandex Cloud: реальные ASR (SpeechKit STT) + TTS + Translate ---
# Нужен платёжный аккаунт Yandex Cloud, сервисный аккаунт с ролями
# ai.speechkit-stt.user, ai.speechkit-tts.user, ai.translate.user, API-ключ и folder_id.
# Без них перевод падает на заглушку, а голосовые роуты вернут 503.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Опционально: поиск для ресёрча через MCP Tavily ---
# TAVILY_API_KEY=your_tavily_key_here
