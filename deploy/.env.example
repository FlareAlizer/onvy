# Onvy — production environment. Copy to .env in the REPO ROOT (not deploy/):
#   cp deploy/.env.example .env
# then fill in real values. .env is git-ignored — never commit it.
#
# Имена переменных = UPPER_SNAKE_CASE от полей app/config.py:Settings
# (pydantic-settings сопоставляет их без учёта регистра). Consumed by:
# deploy/docker-compose.yml (интерполяция + env_file в контейнеры) и приложением.

# --- Среда ---
# dev | prod —prod включает строгую валидацию: SECRET_KEY >= 32 символов,
# DEBUG обязан быть false, DATABASE_URL не может указывать на sqlite, и Yandex
# должен быть настроен, если он используется как ASR/fallback-провайдер.
ENV=prod
DEBUG=false

# --- Секрет подписи JWT (access + refresh) ---
# Генерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Меняется — все выданные токены сразу становятся недействительными.
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# Сколько раз подряд можно ошибиться PIN-ом до временной блокировки входа.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# --- Postgres ---
# POSTGRES_* — учётка самой БД (образ postgres читает их напрямую).
# DATABASE_URL должен указывать на те же значения — держите их в синхроне,
# они не связаны автоматически.
POSTGRES_USER=onvy
POSTGRES_PASSWORD=
POSTGRES_DB=onvy
DATABASE_URL=postgresql+asyncpg://onvy:CHANGE_ME@postgres:5432/onvy

# --- Redis (EventBusPort: pub/sub рации/broadcast, WS-тикеты) ---
REDIS_URL=redis://redis:6379/0

# --- Язык по умолчанию для новых сотрудников/подсказок ассистента ---
DEFAULT_LANGUAGE=ru

# --- Распознавание речи: провайдер на пилоте ---
# yandex — включён по умолчанию, не зависит от готовности GPU-ноды к 31.07.
# gigaam — GigaAM-Multilingual на отдельной GPU-ноде (флагом, по готовности).
ASR_PROVIDER=yandex
# Куда падать, если основной провайдер не покрывает язык. Пустая строка — без запасного.
ASR_FALLBACK_PROVIDER=yandex
# URL GPU-ноды с GigaAM-Multilingual (HTTP). Обязателен, если ASR_PROVIDER=gigaam.
GIGAAM_URL=
GIGAAM_TIMEOUT_SECONDS=15.0
# Языки, которые отдаём GigaAM (без таджикского — у GigaAM его нет).
GIGAAM_LANGUAGES=ru,uz,kk,ky,en

# --- Yandex Cloud: ASR (SpeechKit STT), TTS, Translate, YandexGPT ---
# Обязательны, если ASR_PROVIDER=yandex или ASR_FALLBACK_PROVIDER=yandex (в prod
# приложение падает на старте, если это условие не выполнено).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite

# --- Хранение сырого аудио (правовой гейт §7 спеки) ---
AUDIO_RETENTION_DAYS=7

# --- Caddy / TLS ---
# Домен должен уже указывать A/AAAA-записью на этот сервер до первого запуска
# — иначе Let's Encrypt не выпустит сертификат.
DOMAIN=onvy.example.com
# Контактный email для ACME (уведомления об истечении, не обязателен).
CADDY_EMAIL=ops@example.com
