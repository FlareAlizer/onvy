# Ежедневный запуск бэкапа.
#
# 03:20 UTC — это 06:20 по Москве: смена уже закрылась, дневная ещё не началась.
# Ровные часы не берём намеренно: в них просыпается половина мира, и у хостера
# в это время самый занятый диск.

[Unit]
Description=Onvy: ежедневный бэкап Postgres
Documentation=file://__ONVY_ROOT__/docs/runbook-deploy.md

[Timer]
OnCalendar=*-*-* 03:20:00
# Сервер был выключен или перезагружался в это время — запустить сразу, как
# только поднялся, а не ждать сутки. За две недели пилота пропуск целого дня
# незаметен ровно до того момента, когда бэкап понадобится.
Persistent=true
# Разброс, чтобы дамп не начинался ровно в момент чужих ночных задач.
RandomizedDelaySec=300
Unit=onvy-backup.service

[Install]
WantedBy=timers.target
