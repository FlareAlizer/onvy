# GPU-нода. Копировать в gpu-node/.env (не коммитить):
#   cp gpu-node/.env.example gpu-node/.env

# ctc (220M, по умолчанию) — укладывается в бюджет латентности пилота.
# large_ctc (600M) — точнее, но медленнее и требует больше VRAM. Меняешь —
# пересобери образ (docker compose build), ревизия запекается на сборке.
GIGAAM_REVISION=ctc

# КРИТИЧНО: адрес, на котором Docker публикует порт 8000 НА ЭТОМ ХОСТЕ.
# Сервис без авторизации — если тут окажется 0.0.0.0 или публичный IP,
# распознавание станет доступно кому угодно в интернете.
# По умолчанию 127.0.0.1 — недоступно вообще ни для кого, включая основной
# API. Как только поднят WireGuard/приватная сеть между этой GPU-нодой и
# VPS — впиши сюда IP этой ноды В ТОЙ приватной сети (например, 10.8.0.2).
# См. docs/runbook-gpu-node.md, раздел "Сеть".
GIGAAM_BIND_HOST=127.0.0.1
